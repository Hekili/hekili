actions.precombat+=/soul_harvest,if=soul_shard<3
actions.precombat+=/fel_armor,if=buff.armor.down|buff.armor.remains<180
actions.precombat+=/potion
actions.precombat+=/summon_felhunter,if=!pet.alive
actions.precombat+=/shadow_bolt
actions.precombat+=/haunt

actions+=/run_action_list,name=st,if=active_enemies<2
actions+=/run_action_list,name=aoe,if=active_enemies>1

actions.st+=/synapse_springs,sync=demon_soul,if=time_to_die>71|target.health.pct<25
actions.st+=/fel_flame,if=buff.fel_spark.up
actions.st+=/blood_fury,sync=demon_soul,if=time_to_die>136|target.health.pct<25
actions.st+=/demon_soul,if=time_to_die>136|target.health.pct<25
actions.st+=/soul_fire,if=soul_shard<2&buff.soulburn.up&(buff.soulburn.remains<cast_time+gcd)
actions.st+=/soulburn,if=set_bonus.tier13_4pc
actions.st+=/potion,if=time_to_die<=26|target.health.pct<25
actions.st+=/summon_doomguard,if=buff.trinket_proc.up|buff.demon_soul.up
actions.st+=/bane_of_doom,if=target.time_to_die>60&((debuff.my_bane.down&buff.active_doom.down)|(debuff.bane_of_doom.up&debuff.bane_of_doom.ticks_remain<1))
actions.st+=/bane_of_agony,if=target.time_to_die>5&((debuff.bane_of_agony.up&debuff.bane_of_agony.ticks_remain<1)|debuff.my_bane.down)
actions.st+=/corruption,if=!ticking&debuff.corruption.remains<tick_time
actions.st+=/unstable_affliction,if=!ticking&debuff.unstable_affliction.remains<cast_time+tick_time
actions.st+=/haunt
actions.st+=/life_tap,if=(moving&mana.pct<80&buff.alysrazor_movement.down)|mana.pct<15
actions.st+=/fel_flame,if=buff.fel_spark.up
actions.st+=/drain_soul,if=target.health_pct<25&!moving
actions.st+=/shadowflame,if=target.distance<8
actions.st+=/soulburn
actions.st+=/soul_fire,if=buff.soulburn.up
actions.st+=/curse_of_the_elements,if=debuff.spell_vulnerability.down
actions.st+=/shadow_bolt,if=!moving|buff.alysrazor_movement.up
actions.st+=/fel_flame,if=moving&buff.alysrazor_movement.down

actions.aoe+=/curse_of_the_elements,if=talent.jinx.rank&(target.debuff.jinx_curse_of_the_elements.down&debuff.curse_of_the_elements.remains<3)
actions.aoe+=/seed_of_corruption,if=active_enemies>=6|buff.soulburn.up&active_enemies>2
actions.aoe+=/corruption,cycle_targets=1,if=!ticking&debuff.corruption.remains<tick_time&active_enemies<6
actions.aoe+=/unstable_affliction,cycle_targets=1,if=!ticking&debuff.unstable_affliction.remains<cast_time+tick_time
actions.aoe+=/bane_of_doom,if=target.time_to_die>60&((debuff.my_bane.down&buff.active_doom.down)|(debuff.bane_of_doom.up&debuff.bane_of_doom.ticks_remain<1))
actions.aoe+=/bane_of_agony,if=target.time_to_die>5&((debuff.bane_of_agony.up&debuff.bane_of_agony.ticks_remain<1)|debuff.my_bane.down)
actions.aoe+=/haunt
actions.aoe+=/life_tap,if=(moving&mana.pct<80&buff.alysrazor_movement.down)|mana.pct<15
actions.aoe+=/soul_swap,cycle_targets=1,if=target.debuff.bane_of_agony.up&active_enemies<6
actions.aoe+=/soulburn,if=cooldown.seed_of_corruption.remains<gcd&active_enemies>2
actions.aoe+=/shadowflame,if=target.distance<8
actions.aoe+=/shadow_bolt,cycle_targets=1

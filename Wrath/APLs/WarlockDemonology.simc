## Demonology Warlock
## July 08, 2025

actions.precombat+=/summon_felguard,if=!pet.active
actions.precombat+=/fel_armor,if=buff.armor.down
actions.precombat+=/life_tap,if=buff.life_tap.down
actions.precombat+=/potion
actions.precombat+=/shadow_bolt

actions.metamorphosis+=/metamorphosis
actions.metamorphosis+=/demonic_empowerment
actions.metamorphosis+=/demon_charge,if=buff.metamorphosis.up&target.distance>8&immolation_aura.usable
actions.metamorphosis+=/immolation_aura,if=!up
actions.metamorphosis+=/potion

actions.aoe+=/shadowflame,if=target.distance<10
actions.aoe+=/seed_of_corruption

actions+=/summon_felguard,if=!pet.active
actions+=/potion
actions+=/use_items
actions+=/immolate,if=!ticking&target.time_to_die>dot.immolate.duration+gcd
actions+=/corruption,if=!ticking&target.time_to_die>dot.corruption.duration
actions+=/curse_of_agony,if=!ticking&target.time_to_die>dot.curse_of_agony.duration&curse_of_doom.down
actions+=/curse_of_doom,if=!ticking&target.time_to_die>60
# actions+=/group_curse,if=debuff.my_curse.down&curse_grouped
# actions+=/solo_curse,if=debuff.my_curse.down
actions+=/life_tap,if=buff.life_tap.remains<20|buff.life_tap.down|mana.pct<20
actions+=/call_action_list,name=metamorphosis,if=fight_remains>210|boss&fight_remains<40|lust.up
actions+=/call_action_list,name=aoe,strict=1,if=active_enemies>1
actions+=/shadow_bolt,if=debuff.shadow_mastery.down&debuff.improved_scorch.down
actions+=/soul_fire,if=buff.decimation.up
actions+=/incinerate,if=buff.molten_core.up
actions+=/shadow_bolt